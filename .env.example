# Configuração do servidor. Nunca exponha chaves privadas no navegador.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Opcional: sem estas variáveis, o assistente oferece análises locais calculadas.
GEMINI_API_KEY=
GEMINI_MODEL=

# No Railway: URL HTTPS final do serviço, sem barra no final.
APP_URL=http://localhost:3000

# Necessário para enviar o fechamento mensal ao contador.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Asaas: use a chave do ambiente correspondente (sandbox ou produção).
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Token aleatório criado na configuração do webhook do Asaas; nunca use a API key.
ASAAS_WEBHOOK_TOKEN=
# Necessária somente no servidor para rotinas de cobrança e webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: reduza limites de importação para servidores menores (máximos 2 MB e 2.000 linhas).
STOCK_IMPORT_MAX_BYTES=2000000
STOCK_IMPORT_MAX_ROWS=2000
